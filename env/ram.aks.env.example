RAM_NAMESPACE=ram
RAM_RELEASE=redis-agent-memory

RAM_CHART=redis-ai/redis-agent-memory
RAM_CHART_VERSION=0.1.0
RAM_IMAGE=redislabs/agent-memory:0.1.0

REDIS_ENTERPRISE_OPERATOR_RELEASE=redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_CHART=redis/redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_VERSION=8.0.20-21
REDIS_ENTERPRISE_REC=rec
REDIS_ENTERPRISE_CONTENT_REDB=ram-content
REDIS_ENTERPRISE_JOBS_REDB=ram-jobs

# Azure cluster
AKS_RESOURCE_GROUP=ram-aks-rg
AKS_CLUSTER_NAME=ram-aks
AKS_LOCATION=eastus

# AKS node configuration — AKS uses its current default stable version for the region.
# To pin a specific version: AKS_KUBERNETES_VERSION=1.29  (check: az aks get-versions --location eastus -o table)
AKS_SYSTEM_NODE_VM_SIZE=Standard_D2s_v3
AKS_SYSTEM_NODE_COUNT=2
AKS_USER_NODE_VM_SIZE=Standard_E4s_v3
AKS_USER_NODE_COUNT=3

# Load test VM — provisioned in the same VNet as AKS for internal LB access
AKS_ADMIN_SSH_PUBLIC_KEY=REPLACE_WITH_SSH_PUBLIC_KEY  # e.g. $(cat ~/.ssh/id_ed25519.pub)
AKS_ADMIN_USERNAME=azureuser
AKS_LOADTEST_VM_SIZE=Standard_D4_v5

RAM_STORE_ID=00000000000000000000000000000001
RAM_API_PORT=9000
RAM_WORKER_REPLICAS=2

LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_DURATION=10m
RAM_SEED_COUNT=100

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
