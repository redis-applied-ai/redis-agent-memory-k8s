# Environment variables for the Terraform-based AKS provisioner (ENV=aks-tf).
# Copy this file to .env and fill in the required values.
#
# Note: RAM_CHART, RAM_IMAGE, RAM_CHART_VERSION, and the REDIS_ENTERPRISE_*
# variables are shared with the Bicep variant (ENV=aks) — the same values
# apply regardless of which provisioner you use.

RAM_NAMESPACE=ram
RAM_RELEASE=redis-agent-memory

RAM_CHART=redis-ai/redis-agent-memory
RAM_CHART_VERSION=0.1.0
RAM_IMAGE=redislabs/agent-memory:0.1.0

REDIS_ENTERPRISE_OPERATOR_RELEASE=redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_CHART=redis/redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_VERSION=8.0.20-21
REDIS_ENTERPRISE_REC=rec
REDIS_ENTERPRISE_CONTENT_REDB=ram-content
REDIS_ENTERPRISE_JOBS_REDB=ram-jobs

# Azure cluster
AKS_RESOURCE_GROUP=ram-aks-rg
AKS_CLUSTER_NAME=ram-aks
AKS_LOCATION=eastus

# AKS node configuration — AKS uses its current default stable version for the region.
# To pin a specific version: AKS_KUBERNETES_VERSION=1.29  (check: az aks get-versions --location eastus -o table)
AKS_SYSTEM_NODE_VM_SIZE=Standard_D2s_v3
AKS_SYSTEM_NODE_COUNT=2
AKS_USER_NODE_VM_SIZE=Standard_E4s_v3
AKS_USER_NODE_COUNT=3

# Load test VM — provisioned in the same VNet as AKS for internal LB access
AKS_ADMIN_SSH_PUBLIC_KEY=REPLACE_WITH_SSH_PUBLIC_KEY  # e.g. $(cat ~/.ssh/id_ed25519.pub)
AKS_ADMIN_USERNAME=azureuser
AKS_LOADTEST_VM_SIZE=Standard_D4_v5

RAM_STORE_ID=00000000000000000000000000000001
RAM_API_PORT=9000
RAM_WORKER_REPLICAS=2

LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_DURATION=10m
RAM_SEED_COUNT=100

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# Terraform remote state — required when using a shared Azure Blob Storage backend.
# Run scripts/tf-backend-bootstrap.sh once to create the storage account and get this key.
# The bootstrap script also writes infra/terraform/backend.hcl (gitignored).
# Share the storage account key and backend.hcl values with teammates out of band.
ARM_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCOUNT_KEY

# Azure OpenAI — Terraform provisions the account + chat + embedding deployments
# alongside AKS. All AOAI_* values are optional; defaults are set in
# infra/terraform/variables.tf. Override here if the defaults collide with
# existing names, your region doesn't host the requested model, or you want
# different SKUs / capacity.
#
# AOAI_ACCOUNT_NAME=ram-aoai          # must be globally unique (used as the custom subdomain)
# AOAI_LOCATION=eastus                # override if AKS region doesn't host the chosen models
# AOAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
# AOAI_CHAT_MODEL=gpt-4o-mini
# AOAI_CHAT_MODEL_VERSION=2024-07-18
# AOAI_CHAT_SKU_CAPACITY=50
# AOAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
# AOAI_EMBEDDING_MODEL=text-embedding-3-small
# AOAI_EMBEDDING_MODEL_VERSION=1
# AOAI_EMBEDDING_SKU_CAPACITY=120

# Workload identity — Terraform creates a UAMI, grants it "Cognitive Services
# OpenAI User" on the AOAI account, and federates it to the RAM ServiceAccount
# via the AKS OIDC issuer. These must match the namespace + SA name that the
# RAM helm release actually uses; the defaults match this harness.
#
# RAM_IDENTITY_NAME=ram-aoai-identity
# RAM_SERVICE_ACCOUNT_NAME=redis-agent-memory  # RAM_NAMESPACE above is reused
