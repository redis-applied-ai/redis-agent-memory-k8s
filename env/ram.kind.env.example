RAM_NAMESPACE=ram
RAM_KIND_CLUSTER=ram
RAM_RELEASE=redis-agent-memory

RAM_CHART=redis-ai/redis-agent-memory
RAM_CHART_VERSION=0.1.0
RAM_IMAGE=redislabs/agent-memory:0.1.0

REDIS_ENTERPRISE_OPERATOR_RELEASE=redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_CHART=redis/redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_VERSION=8.0.20-21
REDIS_ENTERPRISE_REC=rec
REDIS_ENTERPRISE_CONTENT_REDB=ram-content
REDIS_ENTERPRISE_JOBS_REDB=ram-jobs

RAM_STORE_ID=00000000000000000000000000000001
RAM_API_PORT=9000
RAM_WORKER_REPLICAS=1

RAM_MONITORING_NAMESPACE=monitoring
RAM_MONITORING_RELEASE=ram-observability
RAM_PROMETHEUS_PORT=9090
RAM_GRAFANA_PORT=3000
RAM_REDIS_METRICS_PATH=/v2

LOCUST_WEB_HOST=127.0.0.1
LOCUST_WEB_PORT=8089
RAM_SEED_COUNT=100

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
