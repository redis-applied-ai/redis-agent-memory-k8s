# Environment variables for the AWS EKS provisioner (ENV=eks).
# Copy this file to .env and fill in / adjust the values.
#
# This deployment runs RAM on EKS but keeps Azure OpenAI as the model provider,
# authenticated via Entra workload identity (no API key). It reuses the UAMI
# created by the AKS deployment (ENV=aks-tf) and adds a second federated
# credential trusting the EKS OIDC issuer.
#
# Prerequisites:
#   - aws CLI authenticated (aws configure / SSO) with rights to create EKS, IAM, EC2.
#   - az CLI logged in (az login) with rights on the AZURE_RESOURCE_GROUP below,
#     to read the UAMI and add a federated credential.
#   - The AKS deployment's UAMI (RAM_IDENTITY_NAME) must already exist.

RAM_NAMESPACE=ram
RAM_RELEASE=redis-agent-memory

RAM_CHART=redis-ai/redis-agent-memory
RAM_CHART_VERSION=0.1.0
# For the Entra POC, use the same image the AKS deployment runs — the one that
# carries the workload-identity support. It lives in a private ACR, so set the
# ACR_PULL_* token below; eks-up.sh creates the 'acr-pull' image pull secret.
# (A public image without Entra support would defeat the POC.)
RAM_IMAGE=ramaoai.azurecr.io/agent-memory:aoai-entra-dev

# Scoped ACR pull token (pull-only on the agent-memory repo). Create with:
#   az acr token create --registry ramaoai --name eks-pull \
#     --repository agent-memory content/read metadata/read
# Then copy the generated password here. Required when RAM_IMAGE is in *.azurecr.io.
ACR_LOGIN_SERVER=ramaoai.azurecr.io
ACR_PULL_USERNAME=eks-pull
ACR_PULL_PASSWORD=REPLACE_WITH_ACR_TOKEN_PASSWORD

REDIS_ENTERPRISE_OPERATOR_RELEASE=redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_CHART=redis/redis-enterprise-operator
REDIS_ENTERPRISE_OPERATOR_VERSION=8.0.20-21
REDIS_ENTERPRISE_REC=rec
REDIS_ENTERPRISE_CONTENT_REDB=ram-content
REDIS_ENTERPRISE_JOBS_REDB=ram-jobs

# EKS cluster
EKS_CLUSTER_NAME=ram-eks
EKS_AWS_REGION=us-east-1
EKS_KUBERNETES_VERSION=1.31
EKS_NODE_INSTANCE_TYPE=m5.xlarge   # >= 2 vCPU / 4Gi per node for Redis Enterprise
EKS_NODE_COUNT=3

# Existing Azure UAMI to federate to (created by ENV=aks-tf). Do NOT recreate it
# here — this module only reads it and adds an EKS federated credential.
AZURE_RESOURCE_GROUP=ram-aks-rg
RAM_IDENTITY_NAME=ram-aoai-identity
RAM_SERVICE_ACCOUNT_NAME=redis-agent-memory   # RAM_NAMESPACE above is reused as the SA namespace

RAM_STORE_ID=00000000000000000000000000000001
RAM_API_PORT=9000
RAM_WORKER_REPLICAS=2

LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_DURATION=10m
RAM_SEED_COUNT=100
